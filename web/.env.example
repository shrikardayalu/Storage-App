# Copy this file to .env.local and adjust values for local development.
# Only NEXT_PUBLIC_* variables are exposed to the browser (inlined at build time).
# Never put secrets in NEXT_PUBLIC_* variables.

# Display name used across the site, metadata, schema, and guides ({app}).
NEXT_PUBLIC_APP_NAME="Storage App"

# Production origin, no trailing slash. Used for canonical URLs, the sitemap,
# Open Graph, and structured data. Must be set for production builds.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# App Store listing URL. Leave empty until the app is published; while empty,
# every call to action is the waitlist form instead.
NEXT_PUBLIC_APP_STORE_URL=""

# App Store Connect provider token (App Analytics → Campaigns). When set, App
# Store links carry a per-page campaign token so installs can be attributed.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=""

# Server-only. Waitlist signups are POSTed here as JSON { email, source, joinedAt }.
# Any webhook works (n8n, Zapier, Loops, an email tool). Required in production;
# in development, signups are logged to the terminal instead.
WAITLIST_WEBHOOK_URL=""
