# Root .gitignore for the Storage App monorepo.
# web/ keeps its own Next.js .gitignore; these rules apply repo-wide.

# Dependencies
node_modules/

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo
.vercel/

# Environment files (only .env.example is committed)
.env
.env.*
!.env.example

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp
*.swp
coverage/

# Xcode / iOS
# ios/StorageApp.xcodeproj and its Info.plist are generated by XcodeGen from ios/project.yml.
ios/StorageApp.xcodeproj/
ios/StorageApp/Info.plist
*.xcresult
ios/Tools/illustrations/preview.html
__pycache__/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.build/
Pods/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Credentials, certificates, and signing keys
*.pem
*.key
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
credentials.json
service-account*.json
secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
